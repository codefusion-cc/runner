# The rules nft 1.0.6 sent as bridge.hex. See tests/nft.rs for how it was recorded.
flush ruleset
table bridge codefusion {
  chain forward {
    type filter hook forward priority 0; policy accept;
    iifname "tap0" meta protocol ip6 drop
    iifname "tap0" meta protocol arp accept
    iifname "tap0" ip daddr 172.16.0.0/12 drop
    iifname "tap0" ip daddr 192.0.2.1 meta l4proto udp udp dport 53 accept
    iifname "tap0" meta l4proto udp udp dport 67 accept
    ip daddr 100.64.0.0/10 drop
    ip daddr 203.0.113.7 drop
    meta l4proto tcp tcp dport 53 accept
    meta l4proto 17 accept
    ct state established,related accept
  }
  chain output {
    type filter hook output priority 0; policy drop;
    meta oif lo accept
  }
}
